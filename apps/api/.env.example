NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL=postgresql://codelens:codelens@localhost:5432/codelens
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=codelens
REDIS_URL=redis://localhost:6379

# Webhook secret of the GitHub App (Settings → Webhook). Several, comma-separated, during a rotation.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRETS=REPLACE_WITH_THE_WEBHOOK_SECRET_OF_THE_APP

# Dashboard sign-in: OAuth credentials of the same GitHub App (Settings → General).
PUBLIC_URL=http://localhost:3001
GITHUB_CLIENT_ID=Iv1.REPLACE_WITH_THE_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_THE_CLIENT_SECRET
# Encrypts the GitHub user tokens kept in sessions: 32 random bytes in base64.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
# Local development runs over plain HTTP.
COOKIE_SECURE=false

# Worker only: identity of the GitHub App (Settings → General).
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_FILE=./github-app.private-key.pem
WORKER_CONCURRENCY=4
