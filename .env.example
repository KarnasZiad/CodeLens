# Docker Compose stack (docker compose --profile app up). Copy to .env, never commit it.
GITHUB_WEBHOOK_SECRETS=REPLACE_WITH_THE_WEBHOOK_SECRET_OF_THE_APP
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.REPLACE_WITH_THE_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_THE_CLIENT_SECRET
SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_IN_BASE64
# Path of the private key downloaded from the settings of the GitHub App.
GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem
