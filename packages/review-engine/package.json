{
  "name": "@codelens/review-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure review engine: diff parsing, analyzers, quality gate and report rendering",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "vitest": "^4.1.12"
  }
}
